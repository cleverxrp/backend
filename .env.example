# ─────────────────────────────────────────────
# SUPABASE (database + service role)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# FIREBASE (authentication)
# ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_CLIENT_EMAIL=
# Keep escaped newlines (\n) when pasting the private key into a single-line env var.
FIREBASE_PRIVATE_KEY=

# ─────────────────────────────────────────────
# nTZS (TZS payment collection, payout, swap infra)
# ─────────────────────────────────────────────
NTZS_API_URL=
NTZS_API_KEY=
NTZS_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# BASE / BLOCKCHAIN
# ─────────────────────────────────────────────
# Public RPC is fine for reads; use a dedicated provider (Alchemy/Infura/QuickNode) for production.
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
# Use Base Sepolia for development/testing:
# BASE_RPC_URL=https://sepolia.base.org
# BASE_CHAIN_ID=84532

# FLOWZA settlement wallet (holds crypto liquidity, signs outbound transfers).
# NEVER commit this. Use a KMS / secrets manager in production, not a raw env var.
SETTLEMENT_WALLET_PRIVATE_KEY=
SETTLEMENT_WALLET_ADDRESS=

# Mnemonic used to derive one unique deposit address per SELL transaction
# (BIP-44), so incoming deposits can be attributed without relying on
# exact-amount matching. As sensitive as a private key — treat accordingly.
HD_WALLET_MNEMONIC=

# Optional: signing secret for your blockchain-webhook provider (Alchemy Notify, QuickNode Streams, etc.)
BLOCKCHAIN_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# FLOWZA
# ─────────────────────────────────────────────
FLOWZA_ENV=development
FLOWZA_DEFAULT_NETWORK=base
# Asset FLOWZA settles in. Confirm the correct token before switching between these:
#   USDC (Circle) on Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   USDC (Circle) on Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
#   USDT on Base: verify the official contract address before production use.
FLOWZA_BUY_ASSET=USDT
FLOWZA_SELL_ASSET=USDT
FLOWZA_ASSET_CONTRACT_ADDRESS=

# Fee configuration (basis points, e.g. 150 = 1.5%)
FLOWZA_FEE_BPS=150
# Quote validity window in seconds
FLOWZA_QUOTE_TTL_SECONDS=120
# Minutes before an unpaid transaction auto-expires
FLOWZA_PAYMENT_WINDOW_MINUTES=20

# Comma-free single origin allowed to call this API from a browser (your frontend's URL).
# Use "*" only in development.
FLOWZA_ALLOWED_ORIGIN=*
